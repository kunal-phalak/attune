{
  "name": "attune",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @attune/web build",
    "check": "vp check",
    "db:generate": "pnpm --filter @attune/database db:generate",
    "db:migrate": "pnpm --filter @attune/database db:migrate",
    "dev": "pnpm --filter @attune/web dev",
    "shopify:spike": "node scripts/verify-shopify/connectivity-spike.mjs",
    "shopify:spike:cleanup": "node scripts/verify-shopify/cleanup-connectivity-products.mjs --delete",
    "start": "pnpm --filter @attune/web start",
    "test": "vp test --run"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@voidzero-dev/vite-plus-core": "0.2.7",
    "vite-plus": "0.2.7",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.22.0"
}
