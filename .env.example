# Public application origin. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public browser token used to render maker locations. Restrict it to Attune origins.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional server-side Mapbox token for geocoding Shopify locations without coordinates.
MAPBOX_ACCESS_TOKEN=

# Neon persistence and authentication.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Liveblocks collaboration.
LIVEBLOCKS_SECRET_KEY=

# Attune authentication. Use at least 32 random characters for each secret.
ATTUNE_SESSION_SECRET=
ATTUNE_JUDGE_TOKEN_HASH=

# R2 exact-version preview storage.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto

# Attune's Shopify app. Keep real values in .env.local or Vercel.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-07
# Must exactly match a Shopify Dev Dashboard redirect URL.
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:3000/api/shopify/oauth/callback
# Recommended: 32 random bytes encoded as base64/base64url, or 64 hexadecimal characters.
# If omitted, Attune derives a domain-separated key from ATTUNE_SESSION_SECRET.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Compatibility diagnostics for a developer-owned Shopify store.
SHOPIFY_STORE_DOMAIN=your-development-store.myshopify.com
SHOPIFY_STOREFRONT_PASSWORD=
SHOPIFY_ONLINE_STORE_PUBLICATION_ID=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
